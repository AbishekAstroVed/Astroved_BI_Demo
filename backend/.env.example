PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/database_name
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# OpenAI API Key Configuration
OPENAI_API_KEY=

# SMTP Mail Configurations (For sending real emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Google Analytics GA4 Credentials
GA_MEASUREMENT_ID=
GA_API_SECRET=
GA_PROPERTY_ID=
GA_ACCESS_TOKEN=

# Google Search Console
GSC_SITE_URL=https://www.example.com
GSC_CLIENT_EMAIL=your_service_account_email@...
GSC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Meta Ads
META_ADS_APP_ID=
META_ADS_APP_SECRET=
META_ADS_PIXEL_ID=
META_ADS_ACCESS_TOKEN=
META_ADS_AD_ACCOUNT_ID=
